# Server
PORT=4002
NODE_ENV=development
LOG_LEVEL=info

# MongoDB
MONGODB_URI=mongodb://localhost:27017/f1_race

# Auth
JWT_SECRET=change_this_to_a_long_random_secret_at_least_32_chars

# CORS (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:3000

# External F1 API token (MDS Paris)
EXTERNAL_API_TOKEN=your_api_token_here
